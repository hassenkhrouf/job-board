# Database (Supabase PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Admin area protection
# Secret used to sign the admin session cookie (any random string).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Admin login password hash (scrypt). Format: saltHex:hashHex
# Generate one with: node -e "console.log(require('./lib/admin/password').hashAdminPassword('your-password'))"
# or: openssl rand -hex 16 | xargs -I{} ... (see docs/DEVELOPMENT_GUIDE.md)
ADMIN_PASSWORD_HASH=

# Public site URL (used for SEO canonical/OG absolute URLs)
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter API key for the AI job importer (lib/ai/providers/openrouter.ts).
# Required to use the real provider (lib/ai/providers/openrouter.ts).
OPENROUTER_API_KEY=

# OpenRouter model id used by the importer. Optional.
# Defaults to inclusionai/ling-3.0-flash:free when unset.
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# Dev-only debug logging for the AI importer. Set to 1 to print the extracted
# content, the final prompt and the AI JSON response to the server console.
# Leave unset in production.
# IMPORT_DEBUG=1
